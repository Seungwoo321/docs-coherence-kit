{
  "docs": {
    "root": "docs",
    "manifest": "docs/index.json",
    "include": ["**/*.md"],
    "exclude": ["issues/**"],
    "frozen": ["decisions/accepted.md"]
  },
  "ownership": [
    {
      "what": "현행 실측 수치",
      "owner": "scope-table.md",
      "hint": "타일 수·배포단위 수는 여기만 적고, 다른 문서는 이 문서를 링크로 인용한다"
    },
    { "what": "낱말의 뜻", "owner": "glossary.md" },
    { "what": "타일 산출물 필드", "owner": "field-spec.md" },
    { "what": "게이트 축과 판정 기준", "owner": "gate-policy.md" }
  ],
  "numbers": {
    "total_row_labels": ["합계", "총계"]
  },
  "measurements": [
    { "label": "등록 타일", "cmd": "node tools/count-tiles.mjs", "expect_in": ["scope-table.md"] },
    { "label": "배포단위", "cmd": "node tools/count-deploy-units.mjs", "expect_in": ["scope-table.md"] }
  ],
  "concepts": ["타일", "기능블록", "배포단위", "호스트", "widgets-shared"],
  "schemas": ["schema/tile.schema.json"],
  "plugins": ["adr"],
  "adr": {
    "bodies": "decisions/accepted.md",
    "cards": "decisions.json",
    "id_pattern": "ADR-\\d{3}"
  }
}
